{
  "private": true,
  "name": "gtmaa",
  "version": "1.0.1",
  "license": "MIT",
  "scripts": {
    "build": "export NODE_OPTIONS=\"--openssl-legacy-provider --no-experimental-fetch\" && preact build --prerenderUrls ./prerender-urls.json",
    "serve": "sirv build --port 8080 --cors --single",
    "dev": "export NODE_OPTIONS=--openssl-legacy-provider && preact watch --prerenderUrls ./prerender-urls.json",
    "lint": "eslint 'src/**/*.{js,jsx,ts,tsx}'"
  },
  "eslintConfig": {
    "parser": "@typescript-eslint/parser",
    "extends": [
      "preact",
      "plugin:@typescript-eslint/recommended"
    ],
    "ignorePatterns": [
      "build/"
    ]
  },
  "dependencies": {
    "preact": "^10.6.5",
    "preact-render-to-string": "^5.1.4",
    "preact-router": "^4.1.2",
    "react-helmet": "^6.1.0"
  },
  "devDependencies": {
    "@types/react-helmet": "^6.1.11",
    "@typescript-eslint/eslint-plugin": "^5.11.0",
    "@typescript-eslint/parser": "^5.11.0",
    "eslint": "^8.9.0",
    "eslint-config-preact": "^1.3.0",
    "preact-cli": "^3.5.0",
    "sass": "1.89.0",
    "sass-loader": "^10.2.0",
    "sirv-cli": "^1.0.0-next.3",
    "typescript": "^4.6.4"
  }
}
